{
  "name": "llm-agent-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Day-by-day local LLM-Agent learning examples.",
  "scripts": {
    "start": "node day01-single-agent-cli/src/cli.js",
    "ask": "node day01-single-agent-cli/src/cli.js",
    "check": "node day01-single-agent-cli/src/check.js",
    "test": "npm run day01:test && npm run day02:test && npm run day03:test && npm run day04:test && npm run day05:test && npm run day06:test && npm run day07:test",
    "day01:ask": "node day01-single-agent-cli/src/cli.js",
    "day01:check": "node day01-single-agent-cli/src/check.js",
    "day01:test": "node day01-single-agent-cli/test/protocol.test.js",
    "day02:ask": "node day02-multi-agent-cli/src/cli.js",
    "day02:test": "node day02-multi-agent-cli/test/multi-agent.test.js",
    "day03:ask": "node day03-memory-and-rag/src/cli.js",
    "day03:test": "node day03-memory-and-rag/test/rag.test.js",
    "day04:tools": "node day04-tools-and-mcp/src/cli.js",
    "day04:test": "node day04-tools-and-mcp/test/tools.test.js",
    "day05:api": "node day05-vue-web-agent/server/index.js",
    "day05:test": "node day05-vue-web-agent/test/agent-api.test.js",
    "day05:web": "npm --prefix day05-vue-web-agent/frontend run dev",
    "day05:build": "npm --prefix day05-vue-web-agent/frontend run build",
    "day06:eval": "node day06-evaluation-observability/src/cli.js",
    "day06:test": "node day06-evaluation-observability/test/eval.test.js",
    "day07:config": "node day07-deploy-and-test-env/src/cli.js --config",
    "day07:health": "node day07-deploy-and-test-env/src/cli.js --health",
    "day07:dry-run": "node day07-deploy-and-test-env/src/cli.js --dry-run",
    "day07:test": "node day07-deploy-and-test-env/test/deploy.test.js"
  },
  "engines": {
    "node": ">=18.17"
  }
}
